# Deployment public HTTPS base URL (auto-detected on Vercel via VERCEL_PROJECT_PRODUCTION_URL)
PUBLIC_BASE_URL=http://localhost:3000

# Canonical Base Mainnet (eip155:8453) USDC receive-only payout address
X402_PAY_TO=0x0d25A44f74868eCE53B305C97139CF4B62963410
X402_NETWORK=eip155:8453

# x402 v2 Coinbase CDP Facilitator (required for live mainnet payment verify/settle)
X402_FACILITATOR_URL=https://api.cdp.coinbase.com/platform/v2/x402
CDP_API_KEY_ID=
CDP_API_KEY_SECRET=

# Security: HTTPS deployments fail closed unless explicitly overridden for staging demos
DEMO_ALLOW_PUBLIC=false

# Upstash Redis REST analytics (call volumes, 402 probes, caller metrics)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
